# OpenRouter (https://openrouter.ai/keys) — alimenta o agente do chat [OBRIGATÓRIA]
OPENROUTER_API_KEY=sk-or-v1-...
# Modelo opcional (padrão: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# LiFi (https://li.fi) — rota de swaps; funciona sem chave (200 req/2h); chave eleva p/ 200/min [OPCIONAL]
LIFI_API_KEY=

# URL pública do app (pós-deploy, ex.: https://b20index.vercel.app) — metadataBase p/ OG [OPCIONAL]
NEXT_PUBLIC_APP_URL=
